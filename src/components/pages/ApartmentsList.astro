---
import Base from '../../layouts/Base.astro';
import ApartmentCard from '../ApartmentCard.astro';
import { SITE, t, type Lang } from '../../data/site';
import { getApartments, countWord, summary } from '../../lib/apartments';

interface Props { lang: Lang }
const { lang } = Astro.props;
const apartments = await getApartments();
const sum = summary(apartments);
const bg = lang === 'bg';
const s = t[lang];
const alternates = { bg: '/bg/apartamenti/', en: '/en/apartments/' };
const title = bg
  ? 'Апартаменти в Пампорово под наем | Елит Пампорово до ски център Малина'
  : 'Apartments in Pamporovo for Rent | Elit Pamporovo near Malina Ski Center';
const desc = bg
  ? `${countWord(sum.count, 'bg', true)} апартамента в Пампорово, всеки от своя собственик: за ${sum.guests} гости${sum.size ? `, ${sum.size} м²` : ''}, с тераса към гората. Близо до ски център Малина.`
  : `${countWord(sum.count, 'en', true)} apartments in Pamporovo, each rented by its owner: ${sum.guests} guests${sum.size ? `, ${sum.size} m²` : ''}, forest-view terraces. Close to Malina Ski Center.`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    itemListElement: apartments.map((a, i) => ({
      '@type': 'ListItem', position: i + 1, name: a.name[lang], url: new URL(`/${lang}/${a.slug[lang]}/`, SITE.url).href,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: s.breadcrumbsHome, item: new URL(s.home, SITE.url).href },
      { '@type': 'ListItem', position: 2, name: s.nav.apartments, item: new URL(s.apartments, SITE.url).href },
    ],
  },
];
---
<Base lang={lang} title={title} description={desc} alternates={alternates} jsonLd={jsonLd}>
  <div class="wrap">
    <ol class="crumbs"><li><a href={s.home}>{s.breadcrumbsHome}</a></li><li aria-current="page">{s.nav.apartments}</li></ol>
  </div>
  <section style="padding-top:40px">
    <div class="wrap">
      <span class="eyebrow">{bg ? 'Пампорово · ски център Малина' : 'Pamporovo · Malina Ski Center'}</span>
      <h1 style="max-width:900px">{bg ? 'Апартаменти под наем в Пампорово' : 'Holiday apartments in Pamporovo'}</h1>
      <p class="lead" style="margin-top:20px">
        {bg
          ? `${countWord(sum.count, 'bg', true)} апартамента в комплекс „Елит Пампорово“, сред смърчовата гора и близо до пистите. Всеки се отдава от своя собственик: изберете апартамент и се свържете директно с домакина за свободни дати и цена.`
          : `${countWord(sum.count, 'en', true)} apartments in the Elit Pamporovo complex, set in the spruce forest close to the slopes. Each is rented out by its own owner: pick one and contact the host directly for availability and price.`}
      </p>
      <div class="cards">{apartments.map((a) => <ApartmentCard apt={a} lang={lang} headingLevel="h2" />)}</div>
    </div>
  </section>
</Base>
