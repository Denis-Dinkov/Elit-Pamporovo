---
import Base from '../../layouts/Base.astro';
import Photo from '../Photo.astro';
import ApartmentCard from '../ApartmentCard.astro';
import { SITE, t, type Lang } from '../../data/site';
import { apartments } from '../../data/apartments';
import { getImage } from 'astro:assets';
import cover from '../../assets/photos/common/ski-pamporovo.jpg';
import map from '../../assets/photos/common/ski-karta-pamporovo.jpg';
import lift from '../../assets/photos/common/pamporovo-lift-zima-ski.jpg';

interface Props { lang: Lang }
const { lang } = Astro.props;
const bg = lang === 'bg';
const s = t[lang];
const alternates = { bg: '/bg/blog/ski-v-pamporovo/', en: '/en/blog/skining-pamporovo/' };
const url = new URL(alternates[lang], SITE.url).href;
const title = bg ? 'Ски в Пампорово — писти, лифтове, сезон и съвети за 2026/27' : 'Skiing in Pamporovo — Slopes, Lifts, Season & Tips for 2026/27';
const desc = bg
  ? 'Всичко за ски почивка в Пампорово: колко километра писти има, лифтове, ски център Малина, нощно каране, кога е сезонът и как да стигнете.'
  : 'Everything about a ski holiday in Pamporovo, Bulgaria: how many km of slopes, lifts, Malina Ski Center, night skiing, season dates and how to get there.';
const coverUrl = new URL((await getImage({ src: cover, width: 1200, format: 'jpg' })).src, SITE.url).href;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: title,
    description: desc,
    image: coverUrl,
    datePublished: '2022-02-27',
    dateModified: '2026-10-30',
    inLanguage: lang,
    mainEntityOfPage: url,
    author: { '@type': 'Organization', name: bg ? SITE.name : SITE.nameEn, url: SITE.url },
    publisher: { '@id': SITE.url + '/#business' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: s.breadcrumbsHome, item: new URL(s.home, SITE.url).href },
      { '@type': 'ListItem', position: 2, name: s.nav.ski, item: url },
    ],
  },
];
---
<Base lang={lang} title={title} description={desc} alternates={alternates} ogImage={cover} jsonLd={jsonLd}>
  <Fragment slot="footer-apartments">
    <ul class="footer__list">{apartments.map((a) => <li><a href={`/${lang}/${a.slug[lang]}/`}>{a.name[lang]}</a></li>)}</ul>
  </Fragment>
  <article class="article">
    <ol class="crumbs" style="padding:0"><li><a href={s.home}>{s.breadcrumbsHome}</a></li><li aria-current="page">{s.nav.ski}</li></ol>
    {bg ? (
      <>
        <h1>Ски в Пампорово: пълен наръчник за зимата</h1>
        <p class="lead">Пампорово е най-слънчевият ски курорт в България и едно от най-добрите места за начинаещи, семейства и всеки, който иска спокойна зимна ваканция в Родопите.</p>
        <Photo src={cover} alt="Ски писти в Пампорово" widths={[640, 1000, 1371]} sizes="(max-width: 760px) 100vw, 720px" eager />
        <h2>Пампорово в цифри</h2>
        <ul>
          <li><strong>Надморска височина:</strong> между 1620 и 1926 м (връх Снежанка).</li>
          <li><strong>Писти:</strong> около 30 км за ски и сноуборд, за всички нива.</li>
          <li><strong>Лифтове:</strong> 13, с капацитет над 11 000 души на час — опашките са рядкост.</li>
          <li><strong>Слънце:</strong> около 120 слънчеви дни през зимата.</li>
          <li><strong>Изкуствен сняг:</strong> снежни оръдия покриват около 90% от пистите.</li>
        </ul>
        <p><em>Данните са ориентировъчни, по информация на курорта — проверете актуалното състояние на пистите преди пътуването.</em></p>
        <h2>За начинаещи и семейства</h2>
        <p>Пампорово е известен с широките си и полегати писти — идеални за първите завои. В курорта има ски училища с инструктори, които говорят различни езици, и детски зони. По-опитните скиори ще намерят предизвикателство на черната писта „Стената".</p>
        <h2>Ски център Малина</h2>
        <p>Нашите апартаменти се намират близо до ски център Малина — една от входните точки към ски зоната на Пампорово. Така прекарвате повече време на снега и по-малко в път.</p>
        <Photo src={lift} alt="Седалков лифт сред заснежени смърчове в Пампорово" widths={[640, 1000, 1400]} sizes="(max-width: 760px) 100vw, 720px" />
        <h2>Нощно каране и сноуборд</h2>
        <p>Осветената нощна писта удължава деня, а сноубордистите ще оценят халфпайпа и фън парка.</p>
        <h2>Карта на пистите</h2>
        <Photo src={map} alt="Карта на ски пистите в Пампорово" widths={[640, 1000, 1389]} sizes="(max-width: 760px) 100vw, 720px" />
        <h2>Кога е ски сезонът?</h2>
        <p>Сезонът обикновено е от средата на декември до началото на април. Най-оживено е около Коледа, Нова година и през февруари — затова е добре да резервирате настаняване по-рано.</p>
        <h2>Как да стигнете</h2>
        <ul>
          <li>Смолян — около 15 км</li>
          <li>Пловдив — около 85 км (летище Пловдив)</li>
          <li>София — около 240 км</li>
        </ul>
        <h2>Къде да отседнете</h2>
        <p>Изберете между нашите три апартамента близо до ски център Малина — с тераса към гората, оборудвана кухня и място за 4–5 гости.</p>
      </>
    ) : (
      <>
        <h1>Skiing in Pamporovo: the complete winter guide</h1>
        <p class="lead">Pamporovo is the sunniest ski resort in Bulgaria and one of the best places for beginners, families and anyone looking for a relaxed winter holiday in the Rhodope Mountains.</p>
        <Photo src={cover} alt="Ski slopes in Pamporovo" widths={[640, 1000, 1371]} sizes="(max-width: 760px) 100vw, 720px" eager />
        <h2>Pamporovo in numbers</h2>
        <ul>
          <li><strong>Altitude:</strong> between 1,620 and 1,926 m (Snezhanka peak).</li>
          <li><strong>Slopes:</strong> about 30 km for skiing and snowboarding, for all levels.</li>
          <li><strong>Lifts:</strong> 13, with capacity of over 11,000 people per hour — queues are rare.</li>
          <li><strong>Sunshine:</strong> around 120 sunny days each winter.</li>
          <li><strong>Snowmaking:</strong> snow cannons cover about 90% of the runs.</li>
        </ul>
        <p><em>Figures are approximate, based on resort information — check current slope conditions before you travel.</em></p>
        <h2>For beginners and families</h2>
        <p>Pamporovo is known for wide, gentle runs — perfect for first turns. The resort has ski schools with multilingual instructors and kids' areas. Experienced skiers will find their challenge on the black "Wall" run.</p>
        <h2>Malina Ski Center</h2>
        <p>Our apartments are close to Malina Ski Center — one of the gateways to the Pamporovo ski area — so you spend more time on snow and less on the road.</p>
        <Photo src={lift} alt="Chairlift among snowy spruces in Pamporovo" widths={[640, 1000, 1400]} sizes="(max-width: 760px) 100vw, 720px" />
        <h2>Night skiing and snowboarding</h2>
        <p>The floodlit night run extends your day, and snowboarders will enjoy the half-pipe and fun park.</p>
        <h2>Piste map</h2>
        <Photo src={map} alt="Pamporovo ski piste map" widths={[640, 1000, 1389]} sizes="(max-width: 760px) 100vw, 720px" />
        <h2>When is the ski season?</h2>
        <p>The season usually runs from mid-December to early April. Christmas, New Year and February are the busiest — book your accommodation early.</p>
        <h2>Getting there</h2>
        <ul>
          <li>Smolyan — about 15 km</li>
          <li>Plovdiv — about 85 km (Plovdiv Airport)</li>
          <li>Sofia — about 240 km</li>
        </ul>
        <h2>Where to stay</h2>
        <p>Choose one of our three apartments close to Malina Ski Center — each with a forest-view terrace, full kitchen and room for 4–5 guests.</p>
      </>
    )}
  </article>
  <section class="parch">
    <div class="wrap">
      <span class="eyebrow">{s.nav.apartments}</span>
      <div class="cards" style="grid-template-columns:repeat(auto-fit,minmax(260px,1fr))">
        {apartments.map((a) => <ApartmentCard apt={a} lang={lang} />)}
      </div>
    </div>
  </section>
</Base>
