---
// Запитване без сървър: съставя съобщение и го отваря в WhatsApp (или имейл, ако е зададен SITE.email)
import { SITE, type Lang } from '../data/site';
import { apartments } from '../data/apartments';

interface Props { lang: Lang; selected?: string }
const { lang, selected } = Astro.props;
const bg = lang === 'bg';
const phoneDigits = SITE.phone.slice(1);
---
<section class="parch" id="book">
  <div class="wrap book">
    <div>
      <span class="eyebrow">{bg ? 'Запазете своята зима' : 'Book your winter'}</span>
      <h2>{bg ? 'Най-хубавите седмици се заемат първи' : 'The best weeks go first'}</h2>
      <p class="lead" style="margin-top:18px">
        {bg
          ? 'Кажете ни кога и с кого идвате и ще ви отговорим лично. Резервации и на телефон.'
          : 'Tell us when and who is coming, and we will answer personally. You can also book by phone.'}
      </p>
      <ul class="contact">
        <li>{bg ? 'Телефон' : 'Phone'}: <a href={`tel:${SITE.phone}`}><strong>{SITE.phoneDisplay}</strong></a></li>
        <li><a href={`viber://chat?number=%2B${phoneDigits}`}>Viber</a> · <a href={`https://wa.me/${phoneDigits}`} rel="noopener">WhatsApp</a></li>
        {SITE.email && <li>{bg ? 'Имейл' : 'Email'}: <a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>}
      </ul>
    </div>
    <form class="form" id="enquiry" data-phone={phoneDigits} data-email={SITE.email} data-lang={lang}>
      <label class="date" data-ph={bg ? 'Изберете дата' : 'Select date'}>{bg ? 'Пристигане' : 'Check-in'}<input type="date" name="from" required></label>
      <label class="date" data-ph={bg ? 'Изберете дата' : 'Select date'}>{bg ? 'Заминаване' : 'Check-out'}<input type="date" name="to" required></label>
      <label>{bg ? 'Апартамент' : 'Apartment'}
        <select name="apt">
          {apartments.map((a) => <option selected={a.id === selected}>{a.name[lang]}</option>)}
          <option>{bg ? 'Все още не знам' : 'Not sure yet'}</option>
        </select>
      </label>
      <label>{bg ? 'Гости' : 'Guests'}<input type="number" name="guests" min="1" max="5" value="2" inputmode="numeric"></label>
      <label class="full">{bg ? 'Име' : 'Name'}<input name="name" required autocomplete="name"></label>
      <label class="full">{bg ? 'Нещо, което да знаем?' : 'Anything we should know?'}<textarea name="msg" rows="3" placeholder={bg ? 'Деца, специален повод…' : 'Kids, a special occasion…'}></textarea></label>
      <button class="btn" type="submit">{bg ? 'Изпрати запитване' : 'Send enquiry'}</button>
      <p class="form__ok" hidden>{bg ? 'Благодарим! Довършете изпращането в отвореното приложение.' : 'Thank you! Finish sending in the app that just opened.'}</p>
    </form>
  </div>
</section>

<script is:inline>
  (function(){
    var f=document.getElementById('enquiry'); if(!f) return;
    f.addEventListener('submit',function(e){
      e.preventDefault();
      var d=Object.fromEntries(new FormData(f)), bg=f.dataset.lang==='bg';
      var txt=(bg?'Здравейте! Запитване за ':'Hello! Enquiry for ')+d.apt+'\n'+
        (bg?'Пристигане: ':'Check-in: ')+d.from+'\n'+(bg?'Заминаване: ':'Check-out: ')+d.to+'\n'+
        (bg?'Гости: ':'Guests: ')+d.guests+'\n'+(bg?'Име: ':'Name: ')+d.name+(d.msg?'\n\n'+d.msg:'');
      var url=f.dataset.email
        ? 'mailto:'+f.dataset.email+'?subject='+encodeURIComponent((bg?'Запитване: ':'Enquiry: ')+d.apt)+'&body='+encodeURIComponent(txt)
        : 'https://wa.me/'+f.dataset.phone+'?text='+encodeURIComponent(txt);
      window.open(url,'_blank','noopener');
      f.querySelector('.form__ok').hidden=false;
    });
  })();
</script>
