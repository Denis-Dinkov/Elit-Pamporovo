---
// Optimized image: local files go through Astro (AVIF + WebP); Sanity images go through
// their CDN (auto=format serves AVIF/WebP depending on the browser). Lazy by default.
import { Picture } from 'astro:assets';
import { isRemote, type AnyImage } from '../lib/apartments';

interface Props {
  src: AnyImage;
  alt: string;
  widths?: number[];
  sizes?: string;
  eager?: boolean;
  class?: string;
  quality?: number;
}
const { src, alt, widths = [480, 800, 1200], sizes = '(max-width: 760px) 100vw, 50vw', eager = false, class: cls, quality = 70 } = Astro.props;
const usable = widths.filter((w) => w <= src.width);
if (!usable.length) usable.push(src.width);
const maxW = Math.max(...usable);
const h = Math.round((maxW * src.height) / src.width);
const cdn = (w: number) => isRemote(src) ? `${src.url}?w=${w}&q=${quality}&fit=max&auto=format` : '';
---
{isRemote(src) ? (
  // Wrapped in <picture> like Astro's <Picture>, so layout CSS treats both kinds of image the same
  <picture><img
    src={cdn(maxW)}
    srcset={usable.map((w) => `${cdn(w)} ${w}w`).join(', ')}
    sizes={sizes}
    width={maxW}
    height={h}
    alt={alt}
    loading={eager ? 'eager' : 'lazy'}
    decoding={eager ? 'sync' : 'async'}
    fetchpriority={eager ? 'high' : 'auto'}
    class={cls}
  /></picture>
) : (
  <Picture
    src={src}
    alt={alt}
    formats={['avif', 'webp']}
    fallbackFormat="jpg"
    widths={usable}
    width={maxW}
    height={h}
    sizes={sizes}
    quality={quality}
    loading={eager ? 'eager' : 'lazy'}
    decoding={eager ? 'sync' : 'async'}
    fetchpriority={eager ? 'high' : 'auto'}
    class={cls}
  />
)}
