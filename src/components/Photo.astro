---
// Оптимизирана снимка: AVIF + WebP, responsive srcset, lazy по подразбиране
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  widths?: number[];
  sizes?: string;
  eager?: boolean;
  class?: string;
  quality?: number;
}
const { src, alt, widths = [480, 800, 1200], sizes = '(max-width: 760px) 100vw, 50vw', eager = false, class: cls, quality = 70 } = Astro.props;
const usable = widths.filter((w) => w <= src.width);
if (!usable.length) usable.push(src.width);
---
<Picture
  src={src}
  alt={alt}
  formats={['avif', 'webp']}
  fallbackFormat="jpg"
  widths={usable}
  width={Math.max(...usable)}
  height={Math.round((Math.max(...usable) * src.height) / src.width)}
  sizes={sizes}
  quality={quality}
  loading={eager ? 'eager' : 'lazy'}
  decoding={eager ? 'sync' : 'async'}
  fetchpriority={eager ? 'high' : 'auto'}
  class={cls}
/>
