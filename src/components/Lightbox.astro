---
// Преглед на снимките на цял екран (за всички a[data-lb] на страницата)
import type { Lang } from '../data/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const bg = lang === 'bg';
---
<dialog class="lbox" id="lbox" aria-label={bg ? 'Снимки' : 'Photos'}>
  <img alt="" />
  <p class="lbox__cap"></p>
  <button class="lbox__btn lbox__close" type="button" aria-label={bg ? 'Затвори' : 'Close'}>×</button>
  <button class="lbox__btn lbox__prev" type="button" aria-label={bg ? 'Предишна' : 'Previous'}>‹</button>
  <button class="lbox__btn lbox__next" type="button" aria-label={bg ? 'Следваща' : 'Next'}>›</button>
</dialog>

<script is:inline>
  (function(){
    var d=document.getElementById('lbox'); if(!d||!d.showModal) return;
    var links=[].slice.call(document.querySelectorAll('a[data-lb]')), img=d.querySelector('img'), cap=d.querySelector('.lbox__cap'), i=0;
    var show=function(n){ i=(n+links.length)%links.length; img.src=links[i].href; img.alt=links[i].dataset.alt||''; cap.textContent=(i+1)+' / '+links.length+'  ·  '+(links[i].dataset.alt||''); };
    links.forEach(function(a,n){ a.addEventListener('click',function(e){ e.preventDefault(); show(n); d.showModal(); document.documentElement.style.overflow='hidden'; }); });
    d.addEventListener('close',function(){ document.documentElement.style.overflow=''; });
    d.querySelector('.lbox__close').onclick=function(){ d.close(); };
    d.querySelector('.lbox__prev').onclick=function(){ show(i-1); };
    d.querySelector('.lbox__next').onclick=function(){ show(i+1); };
    d.addEventListener('click',function(e){ if(e.target===d) d.close(); });
    d.addEventListener('keydown',function(e){ if(e.key==='ArrowLeft') show(i-1); if(e.key==='ArrowRight') show(i+1); });
    var x0=null; d.addEventListener('touchstart',function(e){ x0=e.touches[0].clientX; },{passive:true});
    d.addEventListener('touchend',function(e){ if(x0===null) return; var dx=e.changedTouches[0].clientX-x0; if(Math.abs(dx)>40) show(dx<0?i+1:i-1); x0=null; });
  })();
</script>
